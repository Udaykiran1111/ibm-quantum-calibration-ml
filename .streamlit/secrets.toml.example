# For Streamlit Community Cloud deployment
# Go to: share.streamlit.io → Your App → Settings → Secrets
# Paste the contents below (with your real values)

IBM_QUANTUM_TOKEN = "your_token"
MYSQL_HOST        = "your.railway.host"
MYSQL_PORT        = "3306"
MYSQL_USER        = "root"
MYSQL_PASSWORD    = "your_password"
MYSQL_DATABASE    = "ibm_quantum"
